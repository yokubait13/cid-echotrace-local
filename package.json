{
  "name": "cid-echotrace-local",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A private, offline-first audio and video transcription workspace for CID case review.",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "check": "node --check server.mjs && node --check public\\app.js && node --check electron\\main.cjs && node --check electron\\preload.cjs",
    "prepare:offline-runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\prepare-bundled-runtime.ps1",
    "prepackage:win": "npm run prepare:offline-runtime",
    "package:win": "electron-builder --win nsis portable --x64",
    "package:dir": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.cid.echotrace.local",
    "productName": "CID EchoTrace Local",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "public/**/*",
      "electron/**/*",
      "server.mjs",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      { "from": "vendor/engine", "to": "engine", "filter": ["**/*"] },
      { "from": "vendor/models", "to": "models", "filter": ["**/*"] },
      { "from": "vendor/licenses", "to": "licenses", "filter": ["**/*"] },
      { "from": "vendor/runtime-manifest.json", "to": "runtime-manifest.json" }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CID EchoTrace Local",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "24.13.3",
    "ffmpeg-static": "5.3.0"
  },
  "engines": {
    "node": ">=16.14"
  }
}
